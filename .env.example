# Copiar este archivo como .env y completar los valores reales
# NUNCA subir el .env al repositorio

# Django
SECRET_KEY=genera-una-clave-secreta-larga-y-aleatoria
DEBUG=False
ALLOWED_HOSTS=tudominio.com,www.tudominio.com

# Base de datos (si usas Render/Heroku, solo necesitas DATABASE_URL)
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db

# O bien, configuración directa de PostgreSQL local:
DB_NAME=sistema_medico_db
DB_USER=postgres
DB_PASSWORD=tu_password_postgres
DB_HOST=localhost
DB_PORT=5432

# Correo Gmail (usa contraseña de aplicación, no la normal)
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx

# PayPal (obtener en https://developer.paypal.com)
PAYPAL_CLIENT_ID=tu_client_id_de_paypal
PAYPAL_CLIENT_SECRET=tu_client_secret_de_paypal
PAYPAL_MODE=sandbox  # cambiar a 'live' en producción

# ── Facturación Electrónica SRI Ecuador ───────────────────────────────────────
SRI_RUC=9999999999999               # RUC del emisor (13 dígitos)
SRI_RAZON_SOCIAL=MI EMPRESA S.A.
SRI_NOMBRE_COMERCIAL=Mi Sistema
SRI_DIRECCION_MATRIZ=Av. Principal 123, Guayaquil
SRI_OBLIGADO_CONTABILIDAD=NO

SRI_ESTABLECIMIENTO=001
SRI_PUNTO_EMISION=001
SRI_AMBIENTE=1                      # 1=pruebas | 2=produccion
SRI_IVA_PORCENTAJE=12               # 0, 5, 12 o 14

# Certificado digital emitido por el SRI (.p12)
# Opción A (producción Render): contenido del .p12 en base64
# SRI_CERTIFICADO_P12_BASE64=MIIK...muy_largo...
# Opción B (desarrollo local): ruta al archivo .p12
SRI_CERTIFICADO_P12=/ruta/absoluta/certificado.p12
SRI_CERTIFICADO_PASSWORD=clave_del_certificado
